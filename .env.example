# ---------------------------------------------------------------
# CLIENTE360 · Variables de entorno
# Copiá este archivo a .env.local y completá los valores.
# Nunca subas .env.local al repositorio.
# ---------------------------------------------------------------

# Supabase (Settings → API). Estas dos son públicas: viajan al navegador
# y están protegidas por las políticas RLS de la base.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA. Solo servidor (Vercel → Environment Variables). Ignora RLS:
# se usa únicamente para tareas de sistema (webhooks, automatizaciones).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (para los enlaces de los correos de Supabase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Tareas programadas (Vercel Cron → /api/cron/automations)
# Generá un valor aleatorio largo (ej.: openssl rand -hex 32).
CRON_SECRET=

# ---------------------------------------------------------------
# WhatsApp Business Platform (API oficial de Meta) — OPCIONAL
# Sin estas variables, WhatsApp funciona en modo manual (abrir chat,
# plantillas, copiar y registrar). Ver docs/INTEGRACIONES.md
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# --- CLIENTE AI (solo servidor; nunca con prefijo NEXT_PUBLIC_) ---
# Proveedor de IA. Hoy está implementado "anthropic" (Claude).
AI_PROVIDER=anthropic
# Clave de la API de Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Opcional: modelo a usar (por defecto claude-opus-5-5)
AI_MODEL=
